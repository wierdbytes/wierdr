// Wierdr's push relay: docs/relay.md. Secrets (not here): APNS_KEY (the .p8 key, PEM)
// and RELAY_SECRET (signs challenges and grants), set with `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wierdr-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [{ "pattern": "relay.wierdr.workat.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "BUNDLE": "pw.xff.wierdr",
    "TEAM_ID": "AUL4CCB2XY",
    "APNS_KEY_ID": "N3XU3N4B8V"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "wierdr-relay", "database_id": "6e70f0b2-942d-4487-9129-76732dd3cfe4" }
  ],
  "ratelimits": [
    // The app's calls: per client address (challenge, attest) and per App Attest key (devices).
    { "name": "LIMIT_APP", "namespace_id": "7101", "simple": { "limit": 20, "period": 60 } },
    // The daemon's calls: per device token or channel (status changes come at once, at most a few a minute).
    { "name": "LIMIT_PUSH", "namespace_id": "7102", "simple": { "limit": 60, "period": 60 } }
  ]
}
